<Window x:Class="Heroesprofile.Uploader.Windows.WebhookDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Title="Webhook" SizeToContent="WidthAndHeight"
        KeyDown="Window_KeyDown">
    <StackPanel Margin="20" Width="480">
        <TextBlock TextWrapping="Wrap" Margin="0, 0, 0, 8"
                   Text="A webhook lets another program react to your matches automatically. Enter a url and this app will send it an HTTP POST whenever your prematch or postmatch page opens, with a small json payload identifying the event and linking to the match page:" />
        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{StaticResource DimmedTextBrush}" Margin="0, 0, 0, 8" TextWrapping="Wrap"
                   Text='{}{"event": "prematch", "url": "https://www.heroesprofile.com/PreMatch/...", "content": "Match started — ...", "text": "Match started — ..."}' />
        <TextBlock TextWrapping="Wrap" Margin="0, 0, 0, 8"
                   Text="The payload works out of the box with Discord and Slack webhook urls ('content' and 'text' carry a ready-to-post message), so your matches can be announced in a channel with no bot required. Custom receivers can use the 'event' and 'url' fields instead. Requires the Prematch/Postmatch Page options to be enabled. Leave empty to disable." />
        <TextBox x:Name="UrlTextBox" Height="23" />
        <TextBlock x:Name="ErrorTextBlock" Foreground="{StaticResource StatusUploadFailedBrush}" TextWrapping="Wrap" Margin="0, 4, 0, 0" Visibility="Collapsed"
                   Text="Invalid url. Must start with http:// or https://" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0, 12, 0, 0">
            <Button Content="OK" Width="80" Click="Ok_Click" IsDefault="True" />
            <Button Content="Cancel" Width="80" Margin="8, 0, 0, 0" Click="Cancel_Click" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
